model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_QueryOrder = ["DataFolder", "Findings", "Vendor", "Category", "Status", "Date"]

ref table Findings
ref table Vendor
ref table Category
ref table Status
ref table Date
