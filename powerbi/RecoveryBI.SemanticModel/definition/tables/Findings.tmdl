	partition Findings = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "\findings.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"FindingKey", type text}, {"VendorCode", type text}, {"CategoryCode", type text}, {"Status", type text}, {"RefType", type text}, {"Ref", type text}, {"EventDate", type date}, {"DisputeDeadline", type date}, {"DaysLeft", Int64.Type}, {"Currency", type text}, {"RecoverableCents", Int64.Type}, {"ExpiredCents", Int64.Type}, {"ExpectedValueCents", Int64.Type}, {"WinRate", type number}, {"Urgent", type logical}, {"PriorityRank", Int64.Type}, {"MatchTier", type text}, {"Reason", type text}, {"SourceFile", type text}, {"SourceRow", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table
