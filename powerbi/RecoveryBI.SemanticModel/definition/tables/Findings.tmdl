/// One row per deduction or payment the engine decided, with its verdict and the source row that proves it.
table Findings
	lineageTag: cca9e60b-07fd-54de-ab1e-e3c88afd1f8d

	/// Deductions and payments the engine decided, whatever the outcome.
	measure 'Total Findings' = COUNTROWS ( Findings )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 10605c10-d1b7-5061-9a76-0385a338bfa8

	/// Findings that can be disputed now, with evidence.
	measure Claims = CALCULATE ( COUNTROWS ( Findings ), Findings[Status] = "CLAIMABLE" )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 61f5e7b8-1d57-596b-bc5c-75b6125c0745

	/// Money that can be claimed back now, in USD at the engine's exchange rates.
	measure 'Recoverable USD' = DIVIDE ( SUM ( Findings[RecoverableCents] ), 100 )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Money
		lineageTag: 1a15e604-bd0b-5165-b756-7261b268bda8

	/// Money that was recoverable but whose dispute window has closed.
	measure 'Lost to Window USD' = DIVIDE ( SUM ( Findings[ExpiredCents] ), 100 )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Money
		lineageTag: 5593d47d-58ae-53ba-a82f-5ff0177682fc

	/// Recoverable money weighted by each category's historical win rate.
	measure 'Expected Value USD' = DIVIDE ( SUM ( Findings[ExpectedValueCents] ), 100 )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Money
		lineageTag: 487be3c3-af91-5aaf-bc62-c4a8fe29d110

	/// Claims whose dispute window closes within 30 days of the as-of date.
	measure 'Urgent Claims' = CALCULATE ( [Claims], Findings[Urgent] = TRUE () )
		formatString: #,0
		displayFolder: Urgency
		lineageTag: 7b811ba5-55af-57cd-b663-3cb098d2fc07

	/// Recoverable money in claims that must be filed within 30 days.
	measure 'Urgent USD' = CALCULATE ( [Recoverable USD], Findings[Urgent] = TRUE () )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Urgency
		lineageTag: a00f2f77-0812-5129-9e11-e41ec0c18d09

	/// Share of findings that turned out to be claimable.
	measure 'Claim Rate' = DIVIDE ( [Claims] + 0, [Total Findings] )
		formatString: 0.0%
		displayFolder: Ratios
		lineageTag: bcd08350-146c-55de-87e8-671d9225a0ba

	/// Of all money that was ever recoverable, the share lost to missed deadlines.
	measure 'Share Lost to Window' =
			VAR Recoverable = SUM ( Findings[RecoverableCents] )
			VAR Expired = SUM ( Findings[ExpiredCents] )
			RETURN DIVIDE ( Expired, Recoverable + Expired )
		formatString: 0.0%
		displayFolder: Ratios
		lineageTag: 8ba431d0-ccd9-5ce8-9666-79d873c595bd

	/// Average historical win rate of the open claims.
	measure 'Avg Win Rate' = CALCULATE ( AVERAGE ( Findings[WinRate] ), Findings[Status] = "CLAIMABLE" )
		formatString: 0.0%
		displayFolder: Ratios
		lineageTag: c7c058ab-df22-5e9d-a0a5-46f839811328

	/// Ambiguous references a person has to decide.
	measure 'Needs Review' = CALCULATE ( COUNTROWS ( Findings ), Findings[Status] = "NEEDS_REVIEW" )
		formatString: #,0
		displayFolder: Volume
		lineageTag: d933be9b-459a-5a52-a463-654808abe166

	/// Vendors with at least one open claim.
	measure 'Vendors with Claims' = CALCULATE ( DISTINCTCOUNT ( Findings[VendorCode] ), Findings[Status] = "CLAIMABLE" )
		formatString: #,0
		displayFolder: Volume
		lineageTag: 44c948b9-9d72-5fb8-af99-4f389de7bcc4

	/// Recoverable money restricted to claimable rows; blank elsewhere, so work-queue tables hide the rest.
	measure 'Open Claim USD' = CALCULATE ( [Recoverable USD], Findings[Status] = "CLAIMABLE" )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Money
		lineageTag: 8412dd43-66d5-5d2e-aa80-18eb75ca6dad

	/// Recoverable money from deductions dated up to the end of the period; blank after the last deduction.
	measure 'Recoverable USD Running Total' =
			VAR LastDay = MAX ( 'Date'[Date] )
			VAR LastEvent = CALCULATE ( MAX ( Findings[EventDate] ), ALL ( Findings ) )
			RETURN
			    IF (
			        MIN ( 'Date'[Date] ) <= LastEvent,
			        CALCULATE ( [Recoverable USD], 'Date'[Date] <= LastDay, ALL ( 'Date' ) )
			    )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Money
		lineageTag: b86f5b1e-ed30-505b-acc9-26249a1a35ab

