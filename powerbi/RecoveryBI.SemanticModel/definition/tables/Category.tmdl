/// Deduction and payment categories, in report order.
table Category
	lineageTag: 5ad34dc7-b22b-5029-ba50-f2ea6ca3e8ab

	column CategoryCode
		dataType: string
		isHidden
		isKey
		lineageTag: 2c087e8c-e6f0-5da7-9e39-fcb14b7a35a7
		summarizeBy: none
		sourceColumn: CategoryCode

		annotation SummarizationSetBy = User

	column Category
